{
  "name": "dota2-interactive-agent",
  "version": "1.0.0",
  "description": "This project is an interactive agent for Dota 2 that pulls domain knowledge (e.g., hero data, items, mechanics, and strategy) to assist with gameplay questions and decision-making.",
  "main": "index.js",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:web\"",
    "dev:server": "npm run dev --prefix server",
    "dev:web": "npm run dev --prefix web",
    "build": "npm run build --prefix web",
    "start": "npm run start --prefix server",
    "install:all": "npm install && npm install --prefix server && npm install --prefix web"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/senyuanfan/dota2-interactive-agent.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/senyuanfan/dota2-interactive-agent/issues"
  },
  "homepage": "https://github.com/senyuanfan/dota2-interactive-agent#readme",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@types/node": "^25.0.3",
    "concurrently": "^9.2.1"
  }
}
